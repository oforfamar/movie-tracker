#!/sbin/openrc-run

name="movie-tracker"
description="Movie Tracker Web App"

user="movietracker"
group="movietracker"
directory="/opt/movie-tracker"
pidfile="/run/${name}.pid"
output_log="/var/log/${name}.log"
error_log="/var/log/${name}.log"

# Port is hardcoded here — edit this file directly to change it.
# All other config (API keys, MongoDB URI, etc.) is read from .env below.
command="/opt/movie-tracker/venv/bin/uvicorn"
command_args="app.main:app --host 0.0.0.0 --port 8000 --workers 1 --log-level info"
command_user="${user}:${group}"
command_background=true

# Load secrets and config from .env
env_file="${directory}/.env"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /run
    checkpath --directory --owner root:root --mode 0755 /var/log
}
